# Copy this file to .env and fill in YOUR OWN secrets. NEVER commit .env to GitHub.
ADMIN_TOKEN=change-this-to-a-long-random-string
ENGINE_TOKEN=change-this-to-another-long-random-string
SECRET_KEY=change-this-to-a-third-long-random-string
DB_PATH=vortex.db
# Engine -> backend URL
BACKEND_URL=http://127.0.0.1:8000
# Admin login (admin panel + app). Choose your own, strong password.
ADMIN_USER=
ADMIN_PASS=
# Optional: real LLM for the AI tab (otherwise built-in rule-based AI is used)
ANTHROPIC_API_KEY=
# --- Real MT5 trading via MetaApi (metaapi.cloud). Default OFF = virtual trades only.
# MT5_MODE=off | demo | live        (start with demo!)
MT5_MODE=off
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
METAAPI_REGION=new-york
MT5_SYMBOL=XAUUSD
MT5_MAX_LOT=0.10
# live only works if this is set EXACTLY (safety lock):
# MT5_LIVE_CONFIRM=I_ACCEPT_REAL_MONEY_RISK
